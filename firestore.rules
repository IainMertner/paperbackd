rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u.data != null && u.data.get('isAdmin', false) == true;
    }

    // User profiles — any signed-in user can read (needed to show friend names),
    // but only the owner can write their own doc.
    match /users/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin()
        // Allow anyone to remove themselves from this user's following list (remove follower).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following'])
            && request.resource.data.following == resource.data.following.removeAll([request.auth.uid]));
      allow delete: if request.auth.uid == uid;

      // Books subcollection — any signed-in user can read (for friend book status),
      // but only the owner can write. Admins can also write.
      match /books/{bookId} {
        allow read:  if request.auth != null;
        allow write: if request.auth.uid == uid || isAdmin();
      }

      // Owner-only scratch space. The parent user doc is world-readable to
      // signed-in users, so anything secret — the progress sync token — has to
      // live here instead.
      match /private/{docId} {
        allow read, write: if request.auth.uid == uid;
      }

      // Per-reader settings that are not secret. Currently the covers chosen
      // for books that are not in the library, which a visitor has to be able
      // to read: their lists render with those covers. Rules do not cascade
      // from /users/{uid}, so this needs its own.
      match /config/{docId} {
        allow read:  if request.auth != null;
        allow write: if request.auth.uid == uid || isAdmin();
      }

      // Lists subcollection — private lists visible to owner only.
      // Uses .get('private', false) rather than .private: reading a key that
      // does not exist raises an error and denies, which would hide every list
      // created before the private flag was introduced.
      // isAdmin() also lets the backfill migration read every list: without a
      // data-independent clause an unfiltered admin query is not provably safe
      // and Firestore rejects it outright.
      match /lists/{listId} {
        allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin() || resource.data.get('private', false) != true);
        allow write: if request.auth.uid == uid || isAdmin();
      }
    }

    // Activity feed — readable by any signed-in user, writable only by the event owner.
    match /activity/{activityId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      // Also allow the target of a followed event to delete it (remove follower).
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.uid == resource.data.targetUid || isAdmin());
    }

    // Book clubs — private. Only a member can read one at all, which is why
    // joining goes through the joinClubByCode callable: finding a club by its
    // code means reading clubs you are not yet in, and a client that could run
    // that query could enumerate every club on the site.
    match /clubs/{clubId} {
      function club()     { return resource.data; }
      function isMember() { return request.auth != null && request.auth.uid in club().members; }
      function isAdmin_()  { return isMember() && club().members[request.auth.uid].role == 'admin'; }
      function isOwner()  { return request.auth != null && request.auth.uid == club().ownerUid; }

      allow read: if isMember() || isAdmin();

      // Created with yourself as the sole member, and as an admin: a club that
      // arrived with other people already in it would be a way to add someone to
      // a group without asking them.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'admin'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && !('iconUrl' in request.resource.data);

      // Admins change the club. A member may also edit their own entry in the
      // members map, which is what lets someone leave and what keeps their name
      // and avatar current without an admin doing it for them.
      // An icon is a base64 data URL. Capped so a club document cannot be grown
      // without limit, which would slow every member's page load, not just the
      // admin who set it.
      function iconWithinLimit() {
        return !('iconUrl' in request.resource.data)
          || (request.resource.data.iconUrl is string && request.resource.data.iconUrl.size() <= 120000);
      }

      allow update: if (isAdmin_() && iconWithinLimit())
        || isAdmin()
        || (isMember()
            && request.resource.data.diff(club()).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(club().members).affectedKeys().hasOnly([request.auth.uid]));

      // Only the founder can dissolve a club, and never merely by leaving it.
      allow delete: if isOwner() || isAdmin();

      match /meetings/{meetingId} {
        function parent() { return get(/databases/$(database)/documents/clubs/$(clubId)).data; }
        function memberOfParent() { return request.auth != null && request.auth.uid in parent().members; }
        function adminOfParent()  { return memberOfParent() && parent().members[request.auth.uid].role == 'admin'; }

        allow read:  if memberOfParent() || isAdmin();
        // The history is the club's shared record, so only an admin writes it.
        allow write: if adminOfParent() || isAdmin();
      }

      // One recommendation per member, keyed by uid. Writing your own is the
      // only write a member gets, which is what makes "one each" structural
      // rather than something the client has to be trusted to honour.
      match /recommendations/{recUid} {
        function parent() { return get(/databases/$(database)/documents/clubs/$(clubId)).data; }
        function memberOfParent() { return request.auth != null && request.auth.uid in parent().members; }
        function adminOfParent()  { return memberOfParent() && parent().members[request.auth.uid].role == 'admin'; }

        allow read: if memberOfParent() || isAdmin();
        allow create, update: if memberOfParent()
          && request.auth.uid == recUid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 500;
        // An admin deletes too: taking the winner off the wheel after a spin is
        // a write to somebody else's recommendation.
        allow delete: if (memberOfParent() && request.auth.uid == recUid) || adminOfParent() || isAdmin();
      }
    }

    // Book issue reports — a reader saying something about a book is wrong.
    //
    // Write-only for readers: anyone signed in can file one under their own uid,
    // and only admins can read the queue. A report names a book and whoever
    // filed it, so leaving it readable would turn the collection into a list of
    // who has been looking at what.
    //
    // Shape-checked on create because this is the one collection any account can
    // add to: without the caps, a single client could write documents of
    // arbitrary size until the bill did the talking.
    match /bookReports/{reportId} {
      allow read:   if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['gbid', 'title', 'author', 'text', 'uid', 'username', 'createdAt', 'resolved'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.gbid is string && request.resource.data.gbid.size() <= 300
        && request.resource.data.title is string && request.resource.data.title.size() <= 500
        && request.resource.data.author is string && request.resource.data.author.size() <= 300
        && request.resource.data.username is string && request.resource.data.username.size() <= 100
        && request.resource.data.resolved == false
        && request.resource.data.createdAt == request.time;
      // Only an admin resolves, reopens or deletes: a reader who could edit
      // their own report could rewrite it after it had been acted on.
      allow update, delete: if isAdmin();
    }

    // Global config (e.g. author country overrides) — readable by any signed-in user,
    // writable only by admins.
    match /config/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Announcements — readable by any signed-in user.
    // Admins can create/delete and edit content; any signed-in user can update reactions only.
    match /announcements/{announcementId} {
      allow read:   if request.auth != null;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
    }

    // Archived activity — same shape as activity, admin-only write, readable by signed-in users.
    match /activity_archive/{activityId} {
      allow read:   if request.auth != null;
      allow write:  if isAdmin();
    }

    // Hardcover metadata cache — shared by all users, so writes are shape-checked
    // to stop one account poisoning everyone else's book metadata.
    match /hc_cache/{key} {
      function validCacheEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['slug', 'coverUrl', 'pages', 'release_year', 'workId', 'isbns', 'cachedAt'])
          && d.slug is string && d.slug.size() > 0 && d.slug.size() <= 300
          && d.coverUrl is string && d.coverUrl.size() <= 2000
          && d.pages is int && d.pages >= 0 && d.pages <= 100000
          && (d.release_year == null || (d.release_year is int && d.release_year >= 0 && d.release_year <= 3000))
          && (!('workId' in d) || (d.workId is string && d.workId.size() > 0 && d.workId.size() <= 100))
          // Optional: entries cached before ISBNs were collected have no such
          // key, and that absence is what marks them for re-lookup. An empty
          // list is a completed lookup for a book that simply has no ISBN.
          && (!('isbns' in d) || (d.isbns is list && d.isbns.size() <= 6))
          && d.cachedAt == request.time;
      }
      allow read:            if request.auth != null;
      allow create, update:  if request.auth != null && validCacheEntry();
      allow delete:          if isAdmin();
    }

    // Progress sync tokens. The document id IS the bearer token, so it must
    // never be readable — a listable collection here would hand every user's
    // token to anyone signed in. Only the syncProgress function reads these,
    // via the admin SDK, which bypasses rules entirely.
    match /syncTokens/{token} {
      allow read:   if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Username index — publicly readable so signup can check availability
    // before the account exists, and so add-friend lookups work.
    // Writable only at account creation, deletable only by the username owner.
    match /usernames/{username} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authEmail']);
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }
  }
}
